<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ljl.agent.mapper.ChatSessionMapper">

    <resultMap id="ChatSessionResultMap"
               type="com.ljl.agent.entity.ChatSession">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="title" column="title"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert"
            parameterType="com.ljl.agent.entity.ChatSession"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO chat_session (
        user_id,
        title
        )
        VALUES (
        #{userId},
        #{title}
        )
    </insert>

    <select id="selectById"
            resultMap="ChatSessionResultMap">
        SELECT
        id,
        user_id,
        title,
        created_at,
        updated_at
        FROM chat_session
        WHERE id = #{id}
    </select>

    <select id="selectByUserId"
            resultMap="ChatSessionResultMap">
        SELECT
        id,
        user_id,
        title,
        created_at,
        updated_at
        FROM chat_session
        WHERE user_id = #{userId}
        ORDER BY updated_at DESC, id DESC
    </select>

    <update id="touchUpdatedAt">
        UPDATE chat_session
        SET updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

</mapper>
