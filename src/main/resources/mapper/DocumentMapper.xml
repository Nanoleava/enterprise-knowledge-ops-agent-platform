<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ljl.agent.mapper.DocumentMapper">

    <resultMap id="DocumentResultMap"
               type="com.ljl.agent.entity.Document">

        <id property="id" column="id"/>

        <result property="userId" column="user_id"/>
        <result property="knowledgeBaseId" column="knowledge_base_id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>

    </resultMap>

    <insert id="insert"
            parameterType="com.ljl.agent.entity.Document"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO document (
        user_id,
        knowledge_base_id,
        title,
        content,
        status
        )
        VALUES (
        #{userId},
        #{knowledgeBaseId},
        #{title},
        #{content},
        #{status}
        )

    </insert>

    <delete id="deleteById">
        DELETE FROM document
        WHERE id = #{id}
    </delete>

    <select id="selectById"
            resultMap="DocumentResultMap">

        SELECT
        id,
        user_id,
        knowledge_base_id,
        title,
        content,
        status,
        created_at,
        updated_at
        FROM document
        WHERE id = #{id}

    </select>

    <select id="selectAll"
            resultMap="DocumentResultMap">

        SELECT
        id,
        user_id,
        knowledge_base_id,
        title,
        content,
        status,
        created_at,
        updated_at
        FROM document
        ORDER BY id DESC

    </select>

    <select id="selectByKnowledgeBaseId"
            resultMap="DocumentResultMap">

        SELECT
        id,
        user_id,
        knowledge_base_id,
        title,
        content,
        status,
        created_at,
        updated_at
        FROM document
        WHERE knowledge_base_id = #{knowledgeBaseId}
        ORDER BY id DESC

    </select>

    <select id="selectByKnowledgeBaseIdAndTitle"
            resultMap="DocumentResultMap">

        SELECT
        id,
        user_id,
        knowledge_base_id,
        title,
        content,
        status,
        created_at,
        updated_at
        FROM document
        WHERE knowledge_base_id = #{knowledgeBaseId}
        AND title = #{title}
        LIMIT 1

    </select>

    <sql id="DocumentPageConditions">
        <where>
            <if test="keyword != null and keyword != ''">
                AND (
                title LIKE CONCAT('%', #{keyword}, '%')
                OR content LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>

            <if test="knowledgeBaseId != null">
                AND knowledge_base_id = #{knowledgeBaseId}
            </if>
        </where>
    </sql>

    <select id="selectPage"
            resultMap="DocumentResultMap">

        SELECT
        id,
        user_id,
        knowledge_base_id,
        title,
        content,
        status,
        created_at,
        updated_at
        FROM document

        <include refid="DocumentPageConditions"/>

        ORDER BY created_at DESC, id DESC

        LIMIT #{size}
        OFFSET #{offset}
    </select>

    <select id="countPage"
            resultType="long">

        SELECT COUNT(*)
        FROM document

        <include refid="DocumentPageConditions"/>
    </select>

</mapper>