# 阶段 3 Day 1 JWT 配置。这里只记录变量格式，禁止提交真实密钥。
JWT_ISSUER=https://ljl-agent-backend.local
JWT_SECRET_BASE64=<使用安全随机数生成的至少32字节密钥，再进行Base64编码>
JWT_ACCESS_TOKEN_TTL=30m

# 建议直接使用 scripts/run-dev.ps1；兼容 Windows PowerShell 5.1 和 PowerShell 7。
# 不要填写 PBKDF2 密码摘要、${JWT_SECRET_BASE64}、$env:JWT_SECRET_BASE64 或其他带 $ 的占位文本。
# 开发环境也可以使用 scripts/run-dev.ps1；脚本会为本次进程生成缺失/非法/过短的 JWT 密钥。
