# 阶段 3 Day 1 JWT 配置。这里只记录变量格式，禁止提交真实密钥。
JWT_ISSUER=https://ljl-agent-backend.local
JWT_SECRET_BASE64=<使用安全随机数生成的至少32字节密钥，再进行Base64编码>
JWT_ACCESS_TOKEN_TTL=30m

# 阶段 3 Day 2 Redis。无密码的本地容器可让 REDIS_PASSWORD 保持未设置；
# 生产环境必须通过部署环境注入真实密码，禁止提交到仓库。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_CONNECT_TIMEOUT=2s
REDIS_TIMEOUT=2s

# 代表性消息写接口固定窗口限流，默认 20 次/1 分钟。
RATE_LIMIT_CHAT_MESSAGE_LIMIT=20
RATE_LIMIT_CHAT_MESSAGE_WINDOW=1m
RATE_LIMIT_KEY_TTL_BUFFER=5s

# 阶段 4 DAY 1 文档摄取。DAY 1 仅支持 UTF-8 TXT/Markdown。
DOCUMENT_STORAGE_ROOT=./storage/uploads
DOCUMENT_MAX_FILE_SIZE=10MB
DOCUMENT_MAX_REQUEST_SIZE=11MB
DOCUMENT_ALLOWED_TYPES=TXT,MARKDOWN

# 建议直接使用 scripts/run-dev.ps1；兼容 Windows PowerShell 5.1 和 PowerShell 7。
# 不要填写 PBKDF2 密码摘要、${JWT_SECRET_BASE64}、$env:JWT_SECRET_BASE64 或其他带 $ 的占位文本。
# 开发环境也可以使用 scripts/run-dev.ps1；脚本会为本次进程生成缺失/非法/过短的 JWT 密钥。
